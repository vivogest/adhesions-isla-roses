: "225", "c": 0.08}, {"pt": "226", "c": 0.08}, {"pt": "31", "c": 0.26}, {"pt": "32", "c": 0.26}, {"pt": "33", "c": 0.26}, {"pt": "34", "c": 0.26}, {"pt": "35", "c": 0.28}, {"pt": "36", "c": 0.29}, {"pt": "37", "c": 0.25}, {"pt": "38", "c": 0.25}, {"pt": "39", "c": 0.25}, {"pt": "401", "c": 0.12}, {"pt": "402", "c": 0.12}, {"pt": "41", "c": 0.33}], "1": [{"pt": "31", "c": 0.12}, {"pt": "32", "c": 0.12}, {"pt": "33", "c": 0.12}, {"pt": "34", "c": 0.12}, {"pt": "35", "c": 0.12}, {"pt": "36", "c": 0.12}, {"pt": "37", "c": 0.12}, {"pt": "38", "c": 0.12}, {"pt": "39", "c": 0.12}, {"pt": "40", "c": 0.16}, {"pt": "41", "c": 0.16}, {"pt": "42", "c": 0.12}, {"pt": "43", "c": 0.12}, {"pt": "44", "c": 0.12}, {"pt": "45", "c": 0.12}, {"pt": "46", "c": 0.12}, {"pt": "47", "c": 0.12}, {"pt": "48", "c": 0.12}, {"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.33}], "2": [{"pt": "31", "c": 0.12}, {"pt": "32", "c": 0.12}, {"pt": "33", "c": 0.12}, {"pt": "34", "c": 0.12}, {"pt": "35", "c": 0.12}, {"pt": "36", "c": 0.12}, {"pt": "37", "c": 0.12}, {"pt": "38", "c": 0.12}, {"pt": "39", "c": 0.12}, {"pt": "40", "c": 0.16}, {"pt": "41", "c": 0.16}, {"pt": "42", "c": 0.12}, {"pt": "43", "c": 0.12}, {"pt": "44", "c": 0.12}, {"pt": "45", "c": 0.12}, {"pt": "46", "c": 0.12}, {"pt": "47", "c": 0.12}, {"pt": "48", "c": 0.12}, {"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.33}], "3": [{"pt": "41", "c": 0.12}, {"pt": "41", "c": 0.12}, {"pt": "42", "c": 0.12}, {"pt": "43", "c": 0.12}, {"pt": "44", "c": 0.12}, {"pt": "45", "c": 0.12}, {"pt": "46", "c": 0.12}, {"pt": "47", "c": 0.12}, {"pt": "48", "c": 0.12}, {"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.16}, {"pt": "51", "c": 0.16}, {"pt": "52", "c": 0.12}, {"pt": "53", "c": 0.12}, {"pt": "54", "c": 0.12}, {"pt": "55", "c": 0.12}, {"pt": "56", "c": 0.12}, {"pt": "57", "c": 0.12}, {"pt": "58", "c": 0.12}, {"pt": "59", "c": 0.39}], "4": [{"pt": "40", "c": 0.12}, {"pt": "41", "c": 0.12}, {"pt": "42", "c": 0.12}, {"pt": "43", "c": 0.12}, {"pt": "44", "c": 0.12}, {"pt": "45", "c": 0.12}, {"pt": "46", "c": 0.12}, {"pt": "47", "c": 0.12}, {"pt": "48", "c": 0.32}, {"pt": "49", "c": 0.16}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.12}, {"pt": "52", "c": 0.12}, {"pt": "53", "c": 0.12}, {"pt": "54", "c": 0.12}, {"pt": "55", "c": 0.12}, {"pt": "56", "c": 0.23}], "5": [{"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.12}, {"pt": "52", "c": 0.12}, {"pt": "53", "c": 0.12}, {"pt": "54", "c": 0.12}, {"pt": "55", "c": 0.12}, {"pt": "56", "c": 0.12}, {"pt": "57", "c": 0.33}], "6": [{"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.12}, {"pt": "52", "c": 0.12}, {"pt": "53", "c": 0.12}, {"pt": "54", "c": 0.12}, {"pt": "55", "c": 0.4}], "7": [{"pt": "47", "c": 0.12}, {"pt": "48", "c": 0.12}, {"pt": "49", "c": 0.12}, {"pt": "50", "c": 0.12}, {"pt": "51", "c": 0.4}]}, "Zona Comercial": {"0": [{"pt": "07", "c": 0.11}, {"pt": "08", "c": 0.11}, {"pt": "09", "c": 0.11}, {"pt": "10", "c": 0.11}, {"pt": "11", "c": 0.11}, {"pt": "12", "c": 0.11}, {"pt": "13", "c": 0.11}, {"pt": "14", "c": 0.11}, {"pt": "15", "c": 0.11}, {"pt": "16", "c": 0.11}, {"pt": "17", "c": 0.21}, {"pt": "20", "c": 0.29}, {"pt": "21", "c": 0.25}, {"pt": "24", "c": 0.66}, {"pt": "25", "c": 0.1}, {"pt": "26", "c": 0.04}, {"pt": "27", "c": 0.04}, {"pt": "28", "c": 0.04}, {"pt": "29", "c": 0.04}, {"pt": "30", "c": 0.04}, {"pt": "31", "c": 0.04}, {"pt": "32", "c": 0.04}, {"pt": "33", "c": 0.04}, {"pt": "34", "c": 0.04}, {"pt": "35", "c": 0.08}, {"pt": "36", "c": 0.06}, {"pt": "37", "c": 0.11}, {"pt": "38", "c": 0.06}, {"pt": "39", "c": 0.06}, {"pt": "40", "c": 0.05}, {"pt": "41", "c": 0.04}, {"pt": "42", "c": 0.04}, {"pt": "43", "c": 0.04}, {"pt": "44", "c": 0.07}, {"pt": "45", "c": 0.04}, {"pt": "46", "c": 0.03}, {"pt": "47", "c": 0.07}, {"pt": "48", "c": 0.21}, {"pt": "49", "c": 0.03}, {"pt": "50", "c": 0.03}, {"pt": "51", "c": 0.03}, {"pt": "52", "c": 0.01}, {"pt": "53", "c": 0.01}, {"pt": "54", "c": 0.01}, {"pt": "55", "c": 0.01}, {"pt": "56", "c": 0.11}, {"pt": "57", "c": 0.43}]}};
        const CONTRASENA = 'adhesions2026';
        const TOTAL_CADASTRAL = 96.09;
        const LLINDAR_25 = 24.0225;

        let propietarios = [];
        let selectedProperties = [];

        function loginClick() {
            if (document.getElementById('passwordInput').value === CONTRASENA) {
                document.getElementById('loginSection').classList.add('hidden');
                document.getElementById('mainSection').classList.remove('hidden');
                initializeForm();
            } else {
                document.getElementById('passwordError').style.display = 'block';
                document.getElementById('passwordInput').value = '';
            }
        }

        function initializeForm() {
            const zonas = Object.keys(CADASTRE_BY_ZONE).sort();
            const zonaSelect = document.getElementById('zonaSelect');
            zonas.forEach(z => {
                const opt = document.createElement('option');
                opt.value = z;
                opt.textContent = z;
                zonaSelect.appendChild(opt);
            });
        }

        function updatePlantas() {
            const zona = document.getElementById('zonaSelect').value;
            const plantas = zona ? Object.keys(CADASTRE_BY_ZONE[zona]).map(p => parseInt(p)).sort((a,b) => a-b) : [];
            const sel = document.getElementById('plantaSelect');
            sel.innerHTML = '<option value="">Planta</option>';
            plantas.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p;
                opt.textContent = String(p).padStart(2,'0');
                sel.appendChild(opt);
            });
            sel.disabled = !zona;
            document.getElementById('pisoSelect').disabled = true;
            document.getElementById('pisoSelect').innerHTML = '<option value="">Piso</option>';
        }

        function updatePisos() {
            const zona = document.getElementById('zonaSelect').value;
            const planta = document.getElementById('plantaSelect').value;
            const pisos = (zona && planta) ? CADASTRE_BY_ZONE[zona][planta].map(p => ({ pt: p.pt, c: p.c })).sort((a,b) => {
                const aNum = parseInt(a.pt) || 999;
                const bNum = parseInt(b.pt) || 999;
                return aNum - bNum;
            }) : [];
            const sel = document.getElementById('pisoSelect');
            sel.innerHTML = '<option value="">Piso</option>';
            pisos.forEach((p, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                opt.textContent = 'Pt ' + p.pt + ' (' + p.c.toFixed(2) + ')';
                sel.appendChild(opt);
            });
            sel.disabled = pisos.length === 0;
        }

        function addProperty() {
            const zona = document.getElementById('zonaSelect').value;
            const planta = document.getElementById('plantaSelect').value;
            const pisoIdx = document.getElementById('pisoSelect').value;
            
            if (zona && planta && pisoIdx !== '') {
                const pisos = CADASTRE_BY_ZONE[zona][planta];
                const piso = pisos[parseInt(pisoIdx)];
                if (piso) {
                    selectedProperties.push({
                        id: Date.now(),
                        zona: zona,
                        planta: parseInt(planta),
                        porta: piso.pt,
                        coef: piso.c
                    });
                    document.getElementById('zonaSelect').value = '';
                    updatePlantas();
                    renderProperties();
                }
            }
        }

        function renderProperties() {
            const sec = document.getElementById('propertiesSection');
            const list = document.getElementById('propertiesList');
            if (selectedProperties.length === 0) {
                sec.classList.add('hidden');
                return;
            }
            sec.classList.remove('hidden');
            list.innerHTML = selectedProperties.map(p => 
                `<div class="property-item">${p.zona} | Pl ${String(p.planta).padStart(2,'0')} | Pt ${p.porta} <span style="font-weight:500">(${p.coef.toFixed(2)})</span><button type="button" onclick="removeProperty(${p.id})">✕</button></div>`
            ).join('');
            const total = selectedProperties.reduce((s, p) => s + p.coef, 0);
            document.getElementById('propertyTotal').textContent = 'Coef Total: ' + total.toFixed(2);
        }

        function removeProperty(id) {
            selectedProperties = selectedProperties.filter(p => p.id !== id);
            renderProperties();
        }

        function registerPropietario() {
            const nombre = document.getElementById('nombreInput').value;
            if (nombre && selectedProperties.length > 0) {
                const coefTotal = selectedProperties.reduce((s, p) => s + p.coef, 0);
                propietarios.push({
                    id: Date.now(),
                    nombre: nombre,
                    telefono: document.getElementById('telefonoInput').value,
                    email: document.getElementById('emailInput').value,
                    propiedades: [...selectedProperties],
                    coefTotal: coefTotal
                });
                document.getElementById('nombreInput').value = '';
                document.getElementById('telefonoInput').value = '';
                document.getElementById('emailInput').value = '';
                selectedProperties = [];
                renderProperties();
                updateMetrics();
                renderResults();
            }
        }

        function updateMetrics() {
            const total = propietarios.reduce((s, p) => s + p.coefTotal, 0);
            const porcentaje = (total / TOTAL_CADASTRAL) * 100;
            const progressPct = Math.min(100, (total / LLINDAR_25) * 100);
            
            document.getElementById('countPropietarios').textContent = propietarios.length;
            document.getElementById('countCoef').textContent = total.toFixed(2);
            document.getElementById('countPercentatge').textContent = porcentaje.toFixed(1) + '%';
            document.getElementById('progressFill').style.width = progressPct + '%';
            
            if (total >= LLINDAR_25) {
                document.getElementById('progressFill').classList.add('success');
                document.getElementById('successMessage').classList.remove('hidden');
            } else {
                document.getElementById('progressFill').classList.remove('success');
                document.getElementById('successMessage').classList.add('hidden');
            }
        }

        function renderResults() {
            if (propietarios.length === 0) {
                document.getElementById('resultsSection').classList.add('hidden');
                return;
            }
            document.getElementById('resultsSection').classList.remove('hidden');
            document.getElementById('countRegistered').textContent = propietarios.length;
            const tbody = document.getElementById('resultsTable');
            tbody.innerHTML = propietarios.map(p => `
                <tr>
                    <td>${p.nombre}</td>
                    <td>${p.telefono || '-'}</td>
                    <td>${p.email || '-'}</td>
                    <td style="text-align:right;font-weight:500">${p.coefTotal.toFixed(2)}</td>
                    <td style="text-align:center"><button type="button" onclick="deletePropietario(${p.id})" style="width:auto;border:none;color:#dc2626;background:transparent;padding:4px 8px;margin:0;">✕</button></td>
                </tr>
            `).join('');
        }

        function deletePropietario(id) {
            propietarios = propietarios.filter(p => p.id !== id);
            updateMetrics();
            renderResults();
        }

        function downloadExcel() {
            const data = propietarios.map(p => ({
                'Nombre': p.nombre,
                'Teléfono': p.telefono,
                'Email': p.email,
                'Coef Total': p.coefTotal.toFixed(2)
            }));
            const ws = XLSX.utils.json_to_sheet(data);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Adhesiones');
            XLSX.writeFile(wb, 'adhesiones_illa_roses.xlsx');
        }
    </script>
</body>
</html>
